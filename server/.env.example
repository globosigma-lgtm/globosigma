# Postgres (Supabase) — usar a connection string do "Connection pooling" (modo transaction,
# pgbouncer=true), não a direta: funções serverless de vida curta esgotam conexões diretas rápido.
DATABASE_URL=postgresql://postgres:SENHA@db.xxxxxxxxxxxx.supabase.co:6543/postgres?pgbouncer=true

# Supabase Storage (anexos) — a service role key só é usada no servidor, nunca exposta ao navegador.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# JWT — trocar por um valor aleatório real em produção (o código tem um fallback inseguro só para dev).
SIGMA_JWT_SECRET=

# CORS — origem do frontend. Em produção, com o redirect /api/* do netlify.toml, front e back ficam
# no mesmo domínio, então isso é mais uma rede de segurança do que algo crítico.
SIGMA_WEB_ORIGIN=http://localhost:5173

# Ativa cookie "secure" (obrigatório em produção, já que o site roda em HTTPS).
NODE_ENV=development

# LOTE-BG-01 — token compartilhado entre a rota /geracao-lote/:id/confirmar e a Background
# Function netlify/functions/confirmar-lote-background.ts (autenticação servidor-servidor, não
# tem cookie de usuário nessa chamada). Só é usado em produção (Netlify); não precisa em dev local.
SIGMA_INTERNAL_TOKEN=
