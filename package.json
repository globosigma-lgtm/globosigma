{
  "name": "sigma",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:web": "npm run dev --workspace=web",
    "seed": "npm run seed --workspace=server",
    "migrate": "npm run migrate --workspace=server",
    "build:server": "npm run build --workspace=server",
    "build:web": "npm run build --workspace=web",
    "test:all": "npm test --workspace=server && npm test --workspace=web",
    "build:all": "npm run test:all && npm run build:server && npm run build:web",
    "deploy": "npm run build:all && netlify deploy --prod"
  }
}
